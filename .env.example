# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Public GitHub repo link.
# When set, the website shows GitHub links in the nav, hero, pricing, footer, and download page.
NEXT_PUBLIC_OMNICODE_GITHUB_URL="https://github.com/weemadscotsman/omnicode"

# OmniCode authentication (REQUIRED for RBAC + audit to function)
#
# OMNICODE_SESSION_SECRET: random secret (>=16 chars) used to HMAC-sign session
# cookies. Generate one with: node scripts/genkey.mjs secret
OMNICODE_SESSION_SECRET="change-me-to-a-long-random-string"

# OMNICODE_API_KEYS: JSON array mapping HASHED api keys to a user + role.
# Roles: "Admin" | "Developer" | "Read-Only".
# NEVER store raw keys. Generate a key + its record with: node scripts/genkey.mjs key
# Example:
# OMNICODE_API_KEYS='[{"keyHash":"<sha256-of-raw-key>","user":"alice","role":"Admin"}]'
OMNICODE_API_KEYS='[]'

# OmniCode MCP server (the stdio server in ./omnicode-mcp)
#
# OMNICODE_ROLE: role the local MCP server runs as. "admin" | "read-only" | "agent".
# Defaults to "read-only" (least privilege) if unset.
OMNICODE_ROLE="agent"
OMNICODE_USER="mcp-client"

# OMNICODE_ALLOWED_ROOTS: optional. PATH-delimited list of directories the MCP may
# index/read under. If set, a requested repo path outside these roots is rejected.
# Leave unset to allow any path the process can access.
# OMNICODE_ALLOWED_ROOTS="/home/me/projects"
